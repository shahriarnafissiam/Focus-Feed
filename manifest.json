{
  "manifest_version": 3,
  "name": "Muraqabah",
  "version": "8.1",
  "description": "A distraction free Facebook Focus extension which has Clean Feed Mode, Hide Stories, Block Messenger with timer, and Strict Mode countdown lock.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Focus Feed Settings"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.facebook.com/*",
        "*://web.facebook.com/*",
        "*://m.facebook.com/*"
      ],
      "css": [
        "style.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}