{
  "manifest_version": 3,
  "name": "Focus Feed",
  "version": "2.0",
  "description": "Blocks Reels, toggles Clean Feed and Stories, and locks settings during preset or custom Focus Mode.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Focus Feed Settings"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.facebook.com/*"
      ],
      "css": [
        "style.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}